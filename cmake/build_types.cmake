set(CMAKE_C_FLAGS_DEBUG "")
set(CMAKE_C_FLAGS_RELEASE "-DNDEBUG")
set(CMAKE_C_FLAGS_RELWITHDEBINFO "-DNDEBUG")
set(CMAKE_C_FLAGS_MINSIZEREL "-DNDEBUG")

if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(DEF_DEBUG_INFO ON  CACHE INTERNAL "")
    set(DEF_OPTIMIZE   OFF CACHE INTERNAL "")
    set(DEF_LTO        OFF CACHE INTERNAL "")
elseif(CMAKE_BUILD_TYPE STREQUAL "Release")
    set(DEF_DEBUG_INFO OFF CACHE INTERNAL "")
    set(DEF_OPTIMIZE   ON  CACHE INTERNAL "")
    set(DEF_LTO        OFF CACHE INTERNAL "")
elseif(CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
    set(DEF_DEBUG_INFO ON  CACHE INTERNAL "")
    set(DEF_OPTIMIZE   ON  CACHE INTERNAL "")
    set(DEF_LTO        OFF CACHE INTERNAL "")
elseif(CMAKE_BUILD_TYPE STREQUAL "MinSizeRel")
    set(DEF_DEBUG_INFO OFF CACHE INTERNAL "")
    set(DEF_OPTIMIZE   ON  CACHE INTERNAL "")
    set(DEF_LTO        ON  CACHE INTERNAL "")
else()
    set(DEF_DEBUG_INFO OFF CACHE INTERNAL "")
    set(DEF_OPTIMIZE   ON  CACHE INTERNAL "")
    set(DEF_LTO        OFF CACHE INTERNAL "")
endif()
